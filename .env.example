# JagoRoute shared environment (used by docker-compose.yml)
# Copy to .env and adjust for your environment.

# --- Security ---
JWT_SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://jago:jago@localhost:5432/jagoroute
REDIS_URL=redis://localhost:6379/0
GATEWAY_TIMEOUT_SECONDS=3.0
CORS_ORIGINS=http://localhost:3000

# --- Frontend (browser-visible) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1