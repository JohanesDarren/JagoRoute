# Copy to .env for local (non-Docker) development.
# When running via docker-compose, these values are injected by compose.

DATABASE_URL=postgresql+psycopg2://jago:jago@localhost:5432/jagoroute
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GATEWAY_TIMEOUT_SECONDS=3.0
CORS_ORIGINS=http://localhost:3000