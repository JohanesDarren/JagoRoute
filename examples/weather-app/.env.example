# JagoRoute — Weather App consumer .env (EXAMPLE — fill in and copy to .env / .env.local)

# 1) API key: Dashboard -> API Keys -> Generate (e.g. name "Weather App Key")
#    The demo key also works.
JAGO_ROUTE_API_KEY=paste-generated-key-here

# 2) Unified endpoint JagoRoute exposes for your weather station
JAGO_ROUTE_URL=http://localhost:8000/gateway/v1/weather

# 3) Your real mini weather station — CHANGE these:
#    WEATHER_STATION_IP  = reachable address (LAN IP:port, or VPN/tunnel URL)
#    WEATHER_DATA_PATH   = path that returns the JSON (e.g. /, /api/weather, /wind)
WEATHER_STATION_IP=http://192.168.1.100:8080
WEATHER_DATA_PATH=/data