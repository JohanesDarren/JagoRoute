# Copy to .env.local for local development.
# MUST include the /api/v1 prefix (api.ts appends API paths to this base).
# Absolute → browser calls the backend directly (needs CORS).
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Relative → proxied through Next.js via next.config rewrites (BACKEND_URL).
#   NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# OPTIONAL: Override the gateway URL displayed to consumers (shown in route cards).
# Defaults to NEXT_PUBLIC_API_URL with path replaced by /gateway/v1/.
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000/gateway/v1/